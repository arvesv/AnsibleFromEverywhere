{
  "name": "Ansible From Everywhere",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "configureZshAsDefault": "true",
      "installOhMyZsh": "true",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "ansible.ansibleLint.enabled": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[yaml]": {
          "editor.defaultFormatter": "redhat.ansible"
        }
      }
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y openssh-client sshpass rsync && pip install --upgrade pip && pip install -r requirements.txt && ansible-galaxy collection install -r requirements.yml -p collections",
  "remoteUser": "vscode"
}